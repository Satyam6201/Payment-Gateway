# Backend Server Port
PORT=8000

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=payment_gateway

# Alternatively, provide a full MySQL connection URI:
# MYSQL_URI=mysql://root:password@localhost:3306/payment_gateway

# JWT Secret Key for token signing and authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Stripe API Keys (Optional for direct payments, required for Stripe Checkout)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here