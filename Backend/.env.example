# Backend Server Port
PORT=8000

# MongoDB Atlas Connection URI
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/payment_gateway?retryWrites=true&w=majority

# JWT Secret Key for token signing and authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Stripe API Keys (Optional for direct payments, required for Stripe Checkout)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here