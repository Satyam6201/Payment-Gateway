# Backend Server Port
PORT=8000

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mysecretpassword
MYSQL_DATABASE=payment_gateway

# Alternatively, provide a full MySQL connection URI:
# MYSQL_URI=mysql://root:password@localhost:3306/payment_gateway

# JWT Secret Key for token signing and authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Stripe API Keys (Get secret key starting with sk_test_ from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Set to true if you wish to simulate Stripe checkout locally without an active Stripe API key:
STRIPE_MOCK=false